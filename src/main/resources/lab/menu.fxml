<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="400.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lab.controllers.MenuController">
    <children>
        <ImageView fitHeight="400.0" fitWidth="800.0" pickOnBounds="true" preserveRatio="false">
            <image>
                <Image url="@Backgroud.png" />
            </image>
        </ImageView>
        <VBox fx:id="menuContainer" alignment="TOP_CENTER" spacing="30.0">
            <children>
                <Label fx:id="titleLabel" alignment="CENTER" contentDisplay="TOP" text="Ratmaze" textAlignment="CENTER">
                    <font>
                        <Font name="Visitor TT1 BRK" size="48.0" />
                    </font>
                </Label>
                <Button fx:id="startButton" mnemonicParsing="false" onAction="#onStartClick" prefHeight="30.0" prefWidth="150.0" styleClass="menu-btn" stylesheets="@application.css" text="Start Game" textAlignment="CENTER" />
                <Button fx:id="exitButton" mnemonicParsing="false" onAction="#onExitClick" prefHeight="30.0" prefWidth="150.0" styleClass="menu-btn" stylesheets="@application.css" text="End Game" textAlignment="CENTER" />
            </children>
            <cursor>
                <Cursor fx:constant="DEFAULT" />
            </cursor>
            <padding>
                <Insets top="30.0" />
            </padding>
        </VBox>
    </children>
</StackPane>
